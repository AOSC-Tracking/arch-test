#!/usr/bin/perl -w

my ($ok, $no) = (-t 1)? ("\e[32;1m✓\e[0m ", "\e[31;1m✗\e[0m ") : ("", "");

open MAKEFILE, "<Makefile";
{undef local $/; $_=<MAKEFILE>}
close MAKEFILE;

/^ARCHS=((?:[a-z0-9-]| |\t|\\\n)*)/m
    or die "Couldn't parse ARCHS= in the Makefile\n";
$ARCH{$_}=1 for($1=~/[a-z0-9-]+/g);
my @FOUND;

sub alt
{
    my $arch = shift;
    for (@_)
    {
        `which "$_-as"`;
        $VARS{$arch}=$_, last unless $?;
    }
    if ($VARS{$arch})
    {
        s/\$\($arch\)/$VARS{$arch}/g;
    }
    else
    {
        $VARS{$arch}="{".join(',', @_)."}";
        s/\$\($arch\)/$_[0]/g;
    }
}

alt qw(X86 x86_64-aosc-linux-gnu i386-aosc-linux-gnu i486-aosc-linux-gnu i586-aosc-linux-gnu
    i686-aosc-linux-gnu x86_64-aosc-linux-gnux32);
alt qw(MIPS mips-aosc-linux-gnu mipsel-aosc-linux-gnu mips64-aosc-linux-gnuabi64
    mips64el-aosc-linux-gnuabi64);
alt qw(POWERPC powerpc-aosc-linux-gnu powerpc64-aosc-linux-gnu);
alt qw(ARM arm-aosc-linux-gnueabihf arm-aosc-linux-gnueabi);
alt qw(SPARC sparc64-aosc-linux-gnu sparc-aosc-linux-gnu);
alt qw(RISCV riscv64-aosc-linux-gnu riscv32-aosc-linux-gnu);

while (/^arch-test-([a-z0-9-]+):.*\n\t([a-z0-9_.-]+-(?:gcc|as))/mg)
{
    $ARCH{$1} or die "Error: $1 known but not listed.\n";
    delete $ARCH{$1};
    `which $2`;
    if ($?)
    {
        print "${no}Missing $1: $2 not installed\n";
    }
    else
    {
        print "$ok$1: $2\n";
        push @FOUND, "$1";
    }
}

die "Error: ".join(' ',keys %ARCH)." listed but not known.\n" if (%ARCH);

open CONFIG, ">config";
print CONFIG "ARCHS=@FOUND\n";
print CONFIG "$_=$VARS{$_}\n" for keys %VARS;
